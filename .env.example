# Environment Configuration for LocalRank Audit

# Database Connection (PostgreSQL or SQLite fallback for local dev)
DATABASE_URL="file:./dev.db"

# Base Application URL
APP_URL="http://localhost:3000"

# NextAuth / Session Secret
NEXTAUTH_SECRET="your-super-secret-jwt-key-replace-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google API Credentials (Optional - platform functions fully via Mock Providers if unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GOOGLE_PLACES_API_KEY=""

# OpenAI API Key (Optional - server-side AI recommendations & review analysis)
OPENAI_API_KEY=""

# Website Crawler Settings
CRAWLER_MAX_PAGES=20
CRAWLER_TIMEOUT_MS=15000
CRAWLER_USER_AGENT="LocalRankAuditBot/1.0 (+http://localhost:3000/bot)"

# Rank Tracker Provider
# Leave empty to use compliant Mock Provider or show "Rank data provider not configured"
RANK_TRACKER_PROVIDER=""
RANK_TRACKER_API_KEY=""
